# ==============================================================================
# CareerOS Environment Configuration (.env.example)
# Safe placeholder values. NEVER commit real credentials to source control.
# ==============================================================================

# [Required] Node Environment ('development', 'production', or 'test')
NODE_ENV=development

# [Required] Backend Server Port (defaults to 5000 in development, respects process.env.PORT)
PORT=5000

# [Required] Allowed Client Origin for CORS (e.g. https://app.yourdomain.com in production)
CLIENT_URL=http://localhost:5173

# [Required] PostgreSQL Connection URL for Prisma Client (Neon Pooled Connection in Production, Local in Dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/careeros?schema=public"

# [Required for Migrations] Direct PostgreSQL Connection URL (Neon Direct Connection in Production, Local in Dev)
DIRECT_URL="postgresql://postgres:password@localhost:5432/careeros?schema=public"

# [Required] JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=replace_with_min_32_character_cryptographically_secure_random_string_for_access
JWT_REFRESH_SECRET=replace_with_min_32_character_cryptographically_secure_random_string_for_refresh

# [Optional] Token Expirations
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# [Optional] Email Notification Provider ('console', 'resend', 'sendgrid', 'smtp')
# Defaults to 'console' (safe local logging) if omitted.
EMAIL_PROVIDER=console
EMAIL_FROM=EYTHU <notifications@eythu.local>
EMAIL_API_KEY=your_email_provider_api_key_here

# [Optional] Voice Call Provider ('console', 'twilio')
# Defaults to 'console' (safe simulated calls) if omitted.
VOICE_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+1234567890
SERVER_BASE_URL=http://localhost:5000

# [Optional] Observability & Crash Reporting (Production readiness)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# POSTHOG_KEY=phc_exampleKeyHere

# [Required for Frontend Production Build]
# Base URL for API requests. Leave blank or configure according to deployment architecture.
VITE_API_URL=http://localhost:5000/api
